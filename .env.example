APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/earnings_dashboard?sslmode=disable
DATABASE_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# SEC requires a descriptive User-Agent rather than an API key.
# Replace with your application name and real contact email to enable SEC.
# Leave blank to use Yahoo alone; never commit personal configuration.
SEC_USER_AGENT=

# Optional FREE historical revenue consensus. No premium endpoints.
# Shared database budget: at most 24 requests per rolling 24h (two/company),
# 14-second client spacing; successful results cached for seven days.
ALPHA_VANTAGE_API_KEY=
