APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/earnings_dashboard?sslmode=disable
DATABASE_TIMEOUT=5s
SHUTDOWN_TIMEOUT=10s

# Optional free-tier/fallback providers. Leave blank until used.
MASSIVE_API_KEY=
ALPHA_VANTAGE_API_KEY=

# SEC requires a descriptive User-Agent rather than an API key.
SEC_USER_AGENT=earnings-dashboard your-email@example.com
